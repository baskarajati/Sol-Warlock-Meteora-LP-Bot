+// Item 4a: daily-heartbeat / startup status for the LIVE instance. The paper
+// statusFromState reads state.books.N5, which a live state does not have —
+// passing a live state to it would report zero trades and zero PnL. Live state
+// is positions[] + history[]; realised P&L is the sum of history pnlUsd.
+// feesPaidUsd is null by design (gap G-6: live rows record no swap/gas costs).
+function statusFromLiveState(state, extra = {}) {
+  const hist = (state && state.history) || [];
+  const positions = Array.isArray(state && state.positions) ? state.positions
+    : (state && state.position ? [state.position] : []);
+  const today = wibDate();
+  const todays = hist.filter((h) => {
+    try { return wibDate(new Date(h.closedAt)) === today; } catch { return false; }
+  });
+  const sumUsd = (rows) => rows.reduce((s, h) => s + (+(h.pnlUsd != null ? h.pnlUsd : h.netPnlUsd) || 0), 0);
+  return {
+    live: true,
+    startedWib: null, endsWib: null,
+    capitalAsset: 'USDC', virtualUsdc: null, leftoverSol: null,
+    equityUsd: null, totalDepositedUsdc: null,
+    positions: positions.map((p) => ({ capitalAsset: p.capitalAsset || 'USDC', name: p.name, pool: p.pool, entryWib: p.entryWib })),
+    quotePnlTotals: { usd: null, quotes: {} },
+    openCount: positions.length, maxPositions: extra.maxPositions || 5,
+    trades: hist.length, tradesToday: todays.length,
+    pnlToday: null, pnlTotal: null,
+    pnlTodayUsd: sumUsd(todays), pnlTotalUsd: sumUsd(hist),
+    realizedPnlTotalUsd: sumUsd(hist),
+    feesPaidUsd: null,
+    feedHealth: extra.feedHealth || null,
+    stopPresent: !!extra.stopPresent,
+    wallet: extra.wallet || null,
+  };
+}
