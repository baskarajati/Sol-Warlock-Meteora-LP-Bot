+// Item 4a: every send outcome is appended to <instance-root>/alerts.jsonl so the
+// 6-hourly check can read the last-alert timestamp (the notifier previously kept
+// no record at all — a dead Telegram path was invisible). Best-effort only: this
+// must never break alerting. Rotated at ~200KB (keeps the last 1000 lines).
+const ALERT_LOG_FILE = process.env.TELEGRAM_ALERT_LOG_FILE || path.join(ROOT, 'alerts.jsonl');
+function recordAlertOutcome(res) {
+  try {
+    const line = JSON.stringify({ ts: new Date().toISOString(), ok: !!(res && res.ok), error: (res && res.error) || null, skipped: (res && res.skipped) || null, messageId: (res && res.messageId) || null }) + '\n';
+    fs.appendFileSync(ALERT_LOG_FILE, line);
+    try {
+      if (fs.statSync(ALERT_LOG_FILE).size > 200000) {
+        const lines = fs.readFileSync(ALERT_LOG_FILE, 'utf8').trim().split('\n');
+        fs.writeFileSync(ALERT_LOG_FILE, lines.slice(-1000).join('\n') + '\n');
+      }
+    } catch { /* rotation is best-effort */ }
+  } catch { /* alert logging must never break alerting */ }
+}
+function lastAlert() {
+  try {
+    const lines = fs.readFileSync(ALERT_LOG_FILE, 'utf8').trim().split('\n').filter(Boolean);
+    if (!lines.length) return null;
+    return JSON.parse(lines[lines.length - 1]);
+  } catch { return null; }
+}
